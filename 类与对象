"""
定义类
对象创建后自动调用
class 类名：
    def __init__(self,参数列表):
        self.属性名=参数值
"""

class Car:
    def __init__(self,color,name,price):
        self.color=color
        self.name=name
        self.price=price

#创建对象
c1=Car("blue","BMW","5000000")

print(c1.__dict__)